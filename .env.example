# Public (exposed to client). Prefix with PUBLIC_.
PUBLIC_SITE_URL=https://glitchexecutor.com
PUBLIC_TURNSTILE_SITE_KEY=

# Analytics (choose one provider or leave empty to render nothing).
# PUBLIC_ANALYTICS_PROVIDER=plausible
# PUBLIC_ANALYTICS_DOMAIN=glitchexecutor.com
# PUBLIC_ANALYTICS_PROVIDER=umami
# PUBLIC_UMAMI_WEBSITE_ID=
# PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# Server-only (Cloudflare Pages → Settings → Environment variables).
# Do NOT prefix with PUBLIC_.
TURNSTILE_SECRET=

# Resend — contact-form deliveries land at RESEND_TO.
RESEND_API_KEY=
RESEND_FROM=Glitch Executor Labs <support@glitchexecutor.com>
RESEND_TO=support@glitchexecutor.com
# Set to "true" to also send a branded thank-you email to the submitter.
RESEND_AUTOREPLY=

# Optional additional sinks.
SLACK_WEBHOOK_URL=
CONTACT_FORWARD_URL=
