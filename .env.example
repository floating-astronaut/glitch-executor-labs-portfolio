# Public (exposed to client). Prefix with PUBLIC_.
PUBLIC_SITE_URL=https://glitchexecutor.com
PUBLIC_TURNSTILE_SITE_KEY=

# Analytics (choose one provider or leave empty to render nothing).
# PUBLIC_ANALYTICS_PROVIDER=plausible
# PUBLIC_ANALYTICS_DOMAIN=glitchexecutor.com
# PUBLIC_ANALYTICS_PROVIDER=umami
# PUBLIC_UMAMI_WEBSITE_ID=
# PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
# PUBLIC_ANALYTICS_PROVIDER=ga4
# PUBLIC_GA_MEASUREMENT_ID=G-4FTFP3NEQV

# Meta (Facebook) Pixel — set to fire alongside the primary analytics provider.
# PUBLIC_META_PIXEL_ID=1238175855166679

# Google Tag Manager — shared container GTM-TMXWNNLJ serves all 4
# sites. Tags inside the container fire per-site via hostname-based
# triggers (e.g., GA4 config for grow.glitchexecutor.com triggers
# only when Hostname equals that domain). Preferred path: configure
# GA4 / Meta Pixel as tags inside GTM and leave the direct
# PUBLIC_GA_MEASUREMENT_ID / PUBLIC_META_PIXEL_ID env vars unset to
# avoid double-counting.
# PUBLIC_GTM_CONTAINER_ID=GTM-TMXWNNLJ

# Server-only (Cloudflare Pages → Settings → Environment variables).
# Do NOT prefix with PUBLIC_.
TURNSTILE_SECRET=

# Resend — contact-form deliveries land at RESEND_TO.
RESEND_API_KEY=
RESEND_FROM=Glitch Executor Labs <support@glitchexecutor.com>
RESEND_TO=support@glitchexecutor.com
# Set to "true" to also send a branded thank-you email to the submitter.
RESEND_AUTOREPLY=

# Optional additional sinks.
SLACK_WEBHOOK_URL=
CONTACT_FORWARD_URL=
