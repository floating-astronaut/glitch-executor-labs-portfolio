---
import Icon from '~/components/Icon.astro';
import Mascot from '~/components/Mascot.astro';
import { Image } from 'astro:assets';
import heroImage from '~/assets/brand/generated/hero.png';
---

<section class="relative pt-8 pb-12 md:pt-12 md:pb-16 lg:pt-16 lg:pb-20 overflow-hidden">
  {/* Ambient glow. Purely decorative; no layout impact. */}
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 h-[40rem] w-[60rem] max-w-[90vw] rounded-full
                bg-[radial-gradient(circle_at_center,rgb(var(--color-brand)/0.18),transparent_60%)] blur-2xl"></div>
    <div class="absolute top-40 right-[-10rem] h-[30rem] w-[30rem] rounded-full
                bg-[radial-gradient(circle_at_center,rgb(var(--color-electric)/0.14),transparent_60%)] blur-2xl"></div>
  </div>

  <div class="container-app grid md:grid-cols-12 gap-10 items-center">
    <div class="md:col-span-8 reveal">
      <p class="eyebrow">
        <Icon name="spark" size={14} />
        Nuraveda Lab · Independent AI lab
      </p>
      <h1 class="mt-5">
        AI that ships.<br/>
        <span class="gradient-text">In production.</span>
      </h1>
      <p class="mt-6 text-fluid-lg text-muted max-w-[60ch]">
        Two flagships, one operating mode.
        <em class="not-italic text-fg">Glitch Executor</em> is a prop-firm trading
        dashboard — track every challenge, build and test strategies, all your
        connected accounts in one view.
        <em class="not-italic text-fg">Mesh Pilot</em> is the open agent mesh — six
        OSS specialist agents wired through a proprietary orchestration brain.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#flagships" class="btn btn-primary">
          See the flagships
          <Icon name="arrow-right" size={16} />
        </a>
        <a href="#open-source" class="btn btn-secondary">
          Browse open source
          <Icon name="arrow-up-right" size={16} />
        </a>
      </div>

      <dl class="mt-10 grid grid-cols-3 gap-4 max-w-md" aria-label="Lab at a glance">
        <div>
          <dt class="text-fluid-xs uppercase tracking-wider text-subtle">Flagships</dt>
          <dd class="mt-1 font-mono text-fluid-xl text-brand">2</dd>
        </div>
        <div>
          <dt class="text-fluid-xs uppercase tracking-wider text-subtle">OSS projects</dt>
          <dd class="mt-1 font-mono text-fluid-xl text-brand">8</dd>
        </div>
        <div>
          <dt class="text-fluid-xs uppercase tracking-wider text-subtle">Mirror platforms</dt>
          <dd class="mt-1 font-mono text-fluid-xl text-brand">3</dd>
        </div>
      </dl>
    </div>

    <div class="md:col-span-4 reveal">
      <div class="relative">
        <div aria-hidden="true" class="absolute inset-0 blur-3xl opacity-50
                    bg-[radial-gradient(circle_at_center,rgb(var(--color-brand)/0.30),transparent_65%)]"></div>
        <Image
          src={heroImage}
          alt="Nuraveda Lab — Glitch Executor and Mesh Pilot as the two flagship surfaces of one shared agent stack"
          widths={[480, 768, 1024]}
          sizes="(min-width: 768px) 400px, 100vw"
          loading="eager"
          class="relative rounded-lg shadow-glow-brand w-full h-auto"
        />
        <div class="absolute -bottom-6 -left-6 hidden sm:block">
          <Mascot size={72} priority alt="Nuraveda Lab mascot" />
        </div>
      </div>
    </div>
  </div>
</section>
