---
import Icon from '~/components/Icon.astro';

// "How we work" — cross-domain patterns that show up in every sub-brand.
// Picks from the shared infra layer: ensemble router, owned data, edge compute, etc.
const pillars = [
  {
    icon: 'cpu' as const,
    title: 'One ensemble, many domains',
    body:
      'The same 8-model router that ranks trade signals also scores betting edges and ad-spend allocations. Trend, momentum, mean-reversion, session analysts — the patterns transfer once you own the plumbing.',
  },
  {
    icon: 'database' as const,
    title: 'Owned data, not rented access',
    body:
      'Every engagement leaves the client with their own Postgres, their own embeddings, their own audio and call datasets. Fine-tunes run on your data inside your infra — we do not recycle it into ours.',
  },
  {
    icon: 'link' as const,
    title: 'Cross-domain pattern reuse',
    body:
      'The attribution bridge built for a DTC brand informed how our trading executor filters noisy signal feeds. Work done in sports modelling sharpens marketing conversion windows. One codebase, three revenue surfaces.',
  },
  {
    icon: 'shield' as const,
    title: 'Vendor-lock-in avoidance, on purpose',
    body:
      'Open-weight models where latency and privacy matter. Frontier models where reasoning matters. cTrader, MT5, Interactive Brokers all pluggable behind one executor interface. No single API deprecation ends the product.',
  },
  {
    icon: 'layers' as const,
    title: 'Edge compute for the thin bits',
    body:
      'Webhooks, OAuth callbacks, contact forms, OG image generation — Cloudflare Workers and Pages Functions. Heavy ensemble work runs on dedicated GCP. Split by where latency hurts most.',
  },
  {
    icon: 'code' as const,
    title: 'Code is public by default',
    body:
      'Where it is safe to do so, our internal libraries ship under a BSL 1.1 licence that converts to Apache 2.0 in 2030. Transparent moat: the moat is the data and the ops, not the source.',
  },
];
---

<section id="how" class="py-24 md:py-32">
  <div class="container-app">
    <div class="max-w-2xl reveal">
      <p class="eyebrow"><Icon name="code" size={14} /> How we work</p>
      <h2 class="mt-4">Same agent patterns, different surface areas.</h2>
      <p class="mt-5 text-fluid-lg text-muted">
        Trade, Edge, and Grow look like three unrelated products from the outside.
        Under the hood, they share the same router, the same data contracts, the
        same execution primitives — so every improvement compounds across the
        portfolio instead of staying siloed.
      </p>
    </div>

<div aria-hidden="true" class="hidden md:block reveal mt-14 mb-2">
      <svg viewBox="0 0 1080 360" xmlns="http://www.w3.org/2000/svg" class="w-full max-w-5xl mx-auto">
        <defs>
          <marker id="arr-pf" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M0,0 L10,5 L0,10 Z" fill="rgb(var(--color-brand) / 0.7)" />
          </marker>
          <marker id="arr-pf-dim" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M0,0 L10,5 L0,10 Z" fill="rgb(var(--color-border) / 0.9)" />
          </marker>
        </defs>

        <!-- Left column: shared data layers -->
        <g font-family="ui-monospace, monospace" font-size="12">
          <g transform="translate(40 60)">
            <rect width="200" height="44" rx="8" fill="rgb(var(--color-surface) / 0.9)" stroke="rgb(var(--color-border))" />
            <text x="14" y="19" fill="rgb(var(--color-fg))" font-weight="700">Owned datasets</text>
            <text x="14" y="35" fill="rgb(var(--color-subtle))">Postgres · pgvector · audio</text>
          </g>
          <g transform="translate(40 120)">
            <rect width="200" height="44" rx="8" fill="rgb(var(--color-surface) / 0.9)" stroke="rgb(var(--color-border))" />
            <text x="14" y="19" fill="rgb(var(--color-fg))" font-weight="700">Ensemble router</text>
            <text x="14" y="35" fill="rgb(var(--color-subtle))">LangGraph · multi-model</text>
          </g>
          <g transform="translate(40 180)">
            <rect width="200" height="44" rx="8" fill="rgb(var(--color-surface) / 0.9)" stroke="rgb(var(--color-border))" />
            <text x="14" y="19" fill="rgb(var(--color-fg))" font-weight="700">Executor layer</text>
            <text x="14" y="35" fill="rgb(var(--color-subtle))">cTrader · MT5 · IB · CCXT</text>
          </g>
          <g transform="translate(40 240)">
            <rect width="200" height="44" rx="8" fill="rgb(var(--color-surface) / 0.9)" stroke="rgb(var(--color-border))" />
            <text x="14" y="19" fill="rgb(var(--color-fg))" font-weight="700">Edge compute</text>
            <text x="14" y="35" fill="rgb(var(--color-subtle))">Cloudflare Pages + Workers</text>
          </g>
        </g>

        <!-- Centre: one shared core -->
        <g transform="translate(420 120)">
          <rect width="240" height="130" rx="14"
                fill="rgb(var(--color-brand) / 0.06)"
                stroke="rgb(var(--color-brand))" stroke-width="1.5" />
          <text x="120" y="32" text-anchor="middle"
                font-family="ui-monospace, monospace" font-size="13" font-weight="700"
                fill="rgb(var(--color-brand))">GLITCH EXECUTOR LABS</text>
          <g font-family="ui-monospace, monospace" font-size="11" fill="rgb(var(--color-fg))">
            <text x="120" y="58" text-anchor="middle">one codebase</text>
            <text x="120" y="78" text-anchor="middle">one operational team</text>
            <text x="120" y="98" text-anchor="middle">one set of agent patterns</text>
          </g>
          <text x="120" y="120" text-anchor="middle"
                font-family="ui-monospace, monospace" font-size="11"
                fill="rgb(var(--color-brand))">→ three surfaces</text>
        </g>

        <!-- Right column: three product surfaces -->
        <g font-family="ui-monospace, monospace" font-size="12">
          <g transform="translate(840 80)">
            <rect width="200" height="56" rx="10" fill="rgb(var(--color-surface) / 0.9)" stroke="rgb(var(--color-brand) / 0.5)" />
            <text x="14" y="20" fill="rgb(var(--color-fg))" font-weight="700">Glitch Trade</text>
            <text x="14" y="38" fill="rgb(var(--color-subtle))">9-model ensemble for</text>
            <text x="14" y="52" fill="rgb(var(--color-subtle))">trading operators</text>
          </g>
          <g transform="translate(840 152)">
            <rect width="200" height="56" rx="10" fill="rgb(var(--color-surface) / 0.9)" stroke="rgb(var(--color-brand) / 0.5)" />
            <text x="14" y="20" fill="rgb(var(--color-fg))" font-weight="700">Glitch Edge</text>
            <text x="14" y="38" fill="rgb(var(--color-subtle))">sports intelligence for</text>
            <text x="14" y="52" fill="rgb(var(--color-subtle))">quantitative bettors</text>
          </g>
          <g transform="translate(840 224)">
            <rect width="200" height="56" rx="10" fill="rgb(var(--color-surface) / 0.9)" stroke="rgb(var(--color-brand) / 0.5)" />
            <text x="14" y="20" fill="rgb(var(--color-fg))" font-weight="700">Glitch Grow</text>
            <text x="14" y="38" fill="rgb(var(--color-subtle))">attribution + voice for</text>
            <text x="14" y="52" fill="rgb(var(--color-subtle))">e-commerce teams</text>
          </g>
        </g>

        <!-- Arrows in: shared layer → core -->
        <g stroke="rgb(var(--color-border) / 0.9)" stroke-width="1.5" fill="none" marker-end="url(#arr-pf-dim)">
          <path d="M244 82 Q340 82 416 160" />
          <path d="M244 142 Q340 142 416 180" />
          <path d="M244 202 Q340 202 416 200" />
          <path d="M244 262 Q340 262 416 220" />
        </g>

        <!-- Arrows out: core → three surfaces -->
        <g stroke="rgb(var(--color-brand) / 0.7)" stroke-width="1.5" fill="none" marker-end="url(#arr-pf)">
          <path d="M664 150 Q750 150 836 108" />
          <path d="M664 185 Q750 185 836 180" />
          <path d="M664 220 Q750 220 836 252" />
        </g>
      </svg>
    </div>
    <ul class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3" role="list">
      {pillars.map((p) => (
        <li class="card p-6 md:p-7 reveal">
          <span class="inline-flex size-9 items-center justify-center rounded-md bg-brand/10 text-brand border border-brand/20">
            <Icon name={p.icon} size={18} />
          </span>
          <h3 class="mt-4 text-fluid-lg">{p.title}</h3>
          <p class="mt-3 text-fluid-sm text-muted leading-relaxed">{p.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
