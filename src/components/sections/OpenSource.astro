---
import Icon from '~/components/Icon.astro';
import { openSource } from '~/lib/site';
---

<section id="open-source" class="py-10 md:py-12 lg:py-16">
  <div class="container-app">
    <div class="max-w-2xl reveal">
      <p class="eyebrow"><Icon name="layers" size={14} /> Open source</p>
      <h2 class="mt-4">Things we ship in the open.</h2>
      <p class="mt-5 text-fluid-lg text-muted">
        Smaller pieces of work that don't need to be a moat — the parts where
        the next team forking it is the win. MIT licensed, tri-mirrored across
        GitHub, GitLab, and Codeberg so a single account suspension never
        loses the codebase.
      </p>
    </div>

    <ul class="mt-14 grid gap-6 md:grid-cols-3" role="list">
      {openSource.map((p) => (
        <li class="card p-6 md:p-8 reveal group relative flex flex-col h-full
                   hover:border-brand/40 transition-colors">
          <div aria-hidden="true"
               class="pointer-events-none absolute inset-0 -z-10 opacity-0 group-hover:opacity-100
                      transition-opacity duration-500 rounded-[inherit]
                      bg-[radial-gradient(circle_at_top,rgb(var(--color-brand)/0.08),transparent_70%)]">
          </div>

          <div class="flex items-center gap-3">
            <span class="inline-flex size-11 items-center justify-center rounded-md bg-brand/10 text-brand border border-brand/20">
              <Icon name={p.icon} size={22} />
            </span>
            <div class="min-w-0">
              <h3 class="text-fluid-xl leading-none truncate">{p.name}</h3>
              <p class="mt-1 font-mono text-fluid-xs text-subtle">{p.stack}</p>
            </div>
          </div>

          <p class="mt-5 text-fluid-base text-fg/90">{p.tagline}</p>

          <ul class="mt-5 space-y-2 text-fluid-sm" role="list">
            {p.proof.map((line) => (
              <li class="flex items-start gap-2">
                <span class="mt-[3px] text-brand"><Icon name="check" size={14} /></span>
                <span class="text-muted">{line}</span>
              </li>
            ))}
          </ul>

          <div class="mt-auto pt-6 flex items-center gap-4 flex-wrap">
            <a
              href={p.href}
              rel="noopener"
              class="inline-flex items-center gap-1.5 text-brand text-fluid-sm font-medium
                     underline decoration-brand/30 hover:decoration-brand min-h-11 py-2"
              data-cta={`oss-${p.slug}`}
            >
              View source
              <Icon name="arrow-up-right" size={14} />
            </a>
            {'demo' in p && p.demo && (
              <a
                href={p.demo}
                rel="noopener"
                class="inline-flex items-center gap-1.5 text-fluid-sm text-muted
                       hover:text-fg min-h-11 py-2"
                data-cta={`oss-demo-${p.slug}`}
              >
                {p.demo.includes('pypi.org') ? 'PyPI' : 'Live demo'}
                <Icon name="arrow-up-right" size={14} />
              </a>
            )}
            <span class="ml-auto font-mono text-fluid-xs text-subtle uppercase tracking-wider">
              {p.license}
            </span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
